//@version=6
// =============================================================================
//  CVD ENGINE — PHASE 1: PARITY HARNESS
// -----------------------------------------------------------------------------
//  Purpose of this phase is NOT to aggregate anything. It is to prove that our
//  delta computation reproduces TradingView's built-in CVD for a single feed.
//  Once the number matches, aggregation across venues is arithmetic. If we
//  aggregate before proving parity, every downstream signal sits on sand.
//
//  HOW TO VALIDATE
//    1. Add TradingView's built-in "CVD" indicator to the chart.
//    2. Set this script's Venue = "Chart symbol".
//    3. Match Lower Timeframe and Anchor Period between the two.
//    4. Compare the built-in's last value against "CVD" in this script's table.
//    5. If they disagree, cycle Volume Classification until they agree. That
//       identifies the rule TradingView uses, which we then lock in for Phase 2.
//
//  UNITS
//    The built-in CVD reports in BASE units (coins), not USD - a LABUSDT chart
//    reading -31.33M means 31.33 million LAB net sold. We match that, so no FX
//    conversion is needed for KRW/JPY-quoted venues: their volume is already
//    denominated in the base asset. Inverse contracts (BitMEX) are the only
//    exception and are converted explicitly.
// =============================================================================

indicator("CVD Engine — P1 Parity", "CVD·P1", overlay = false, format = format.volume, precision = 2)

// ── groups ───────────────────────────────────────────────────────────────────
const string G_ENG = "Engine"
const string G_VEN = "Venue"
const string G_DSP = "Display"
const string G_TBL = "Diagnostics"

// Pine retrieves at most this many intrabars per request.security_lower_tf call.
const int INTRABAR_CAP = 100000

// ── engine inputs ────────────────────────────────────────────────────────────
// Option list mirrors the built-in CVD's dropdown so settings can be matched
// one-to-one. Tick resolutions are listed for parity of the UI only - Pine's
// request functions cannot retrieve tick data, so they fall back (see below).
string i_ltf = input.string("1 minute", "Lower Timeframe", group = G_ENG,
     options = ["Chart",
                  "1 tick", "10 ticks", "100 ticks", "1000 ticks",
                  "1 second", "5 seconds", "10 seconds", "15 seconds", "30 seconds", "45 seconds",
                  "1 minute", "3 minutes", "5 minutes", "15 minutes", "30 minutes"],
     tooltip = "Chart = no intrabar breakdown (cheap, full history, crude delta).\n" +
               "Seconds require a Pro+ plan. Ticks are not retrievable from Pine " +
               "and fall back to 1 minute.\n\n" +
               "Lower LTF = more accurate delta but far less history. Watch the " +
               "Depth row in the table.")

string i_class = input.string("Bar direction", "Volume Classification", group = G_ENG,
     options = ["Bar direction", "Tick rule", "Proportional"],
     tooltip = "Bar direction: whole intrabar volume is buy if close>open, sell if close<open.\n" +
               "Tick rule: direction from close vs previous intrabar close, ties carry forward.\n" +
               "Proportional: volume split by where close sits inside the intrabar range.\n\n" +
               "Cycle these to find which one matches the built-in CVD.")

string i_anchor = input.string("1 Day", "Anchor Period", group = G_ENG,
     options = ["None", "1 Day", "1 Week", "1 Month"],
     tooltip = "Cumulative delta resets at the start of each period. 'None' " +
               "accumulates from the first bar, which makes the absolute value " +
               "meaningless over long histories.")

// ── venue inputs ─────────────────────────────────────────────────────────────
string i_venue = input.string("Chart symbol", "Venue", group = G_VEN,
     options = ["Chart symbol",
                  "Binance Spot", "Binance Perp",
                  "OKX Spot", "OKX Perp",
                  "Bybit Spot", "Bybit Perp",
                  "Bitget Spot", "Bitget Perp",
                  "Coinbase Spot", "Kraken Spot",
                  "Upbit Spot", "Bithumb Spot",
                  "Gate Spot", "MEXC Spot",
                  "BitMEX Perp"],
     tooltip = "The pair is built from the chart's base currency, so this works " +
               "on any asset. Missing pairs are ignored rather than breaking the " +
               "script - watch the Status row.")

string i_quote = input.string("Auto", "Quote Override", group = G_VEN,
     options = ["Auto", "USDT", "USDC", "USD", "KRW"],
     tooltip = "Auto picks the venue's usual quote asset. Override when a pair " +
               "only lists against a different one.")

// ── display inputs ───────────────────────────────────────────────────────────
string i_mode = input.string("CVD Candles", "Display", group = G_DSP,
     options = ["CVD Candles", "CVD Line", "Per-bar Delta"],
     tooltip = "Mutually exclusive by design - cumulative CVD and per-bar delta " +
               "differ by orders of magnitude and cannot share one axis.")

color i_up  = input.color(#26a69a, "Up",   group = G_DSP, inline = "col")
color i_dn  = input.color(#ef5350, "Down", group = G_DSP, inline = "col")
bool  i_zero = input.bool(true, "Zero line", group = G_DSP)

bool   i_table = input.bool(true, "Show diagnostics", group = G_TBL)
string i_tpos  = input.string("Top Right", "Position", group = G_TBL,
     options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"])

// =============================================================================
//  VENUE REGISTRY
// -----------------------------------------------------------------------------
//  Built as a top-level ternary chain rather than a function so every result
//  stays a `simple string`, which is what request.*() demands. Adding a venue
//  later means extending these three chains.
// =============================================================================

// Non-crypto symbols have no meaningful base currency, so force chart-only mode.
bool   isCrypto  = syminfo.type == "crypto"
string venue     = isCrypto ? i_venue : "Chart symbol"

string base  = syminfo.basecurrency
string baseX = base == "BTC" ? "XBT" : base          // Kraken / BitMEX alias

string qUSDT = i_quote == "Auto" ? "USDT" : i_quote
string qUSD  = i_quote == "Auto" ? "USD"  : i_quote
string qKRW  = i_quote == "Auto" ? "KRW"  : i_quote

string venueSym = venue == "Chart symbol" ? syminfo.tickerid :
  venue == "Binance Spot"  ? "BINANCE:"  + base  + qUSDT :
  venue == "Binance Perp"  ? "BINANCE:"  + base  + qUSDT + ".P" :
  venue == "OKX Spot"      ? "OKX:"      + base  + qUSDT :
  venue == "OKX Perp"      ? "OKX:"      + base  + qUSDT + ".P" :
  venue == "Bybit Spot"    ? "BYBIT:"    + base  + qUSDT :
  venue == "Bybit Perp"    ? "BYBIT:"    + base  + qUSDT + ".P" :
  venue == "Bitget Spot"   ? "BITGET:"   + base  + qUSDT :
  venue == "Bitget Perp"   ? "BITGET:"   + base  + qUSDT + ".P" :
  venue == "Coinbase Spot" ? "COINBASE:" + base  + qUSD :
  venue == "Kraken Spot"   ? "KRAKEN:"   + baseX + qUSD :
  venue == "Upbit Spot"    ? "UPBIT:"    + base  + qKRW :
  venue == "Bithumb Spot"  ? "BITHUMB:"  + base  + qKRW :
  venue == "Gate Spot"     ? "GATEIO:"   + base  + qUSDT :
  venue == "MEXC Spot"     ? "MEXC:"     + base  + qUSDT :
  venue == "BitMEX Perp"   ? "BITMEX:"   + baseX + "USD" :
  syminfo.tickerid

// Volume denomination. BASE = already in coins. USD = inverse contract, volume
// is USD notional and must be divided by price to reach base units.
bool  isInverse = venue == "BitMEX Perp"
float unitMult  = 1.0                                 // contract size multiplier

// =============================================================================
//  TIMEFRAME RESOLUTION
// =============================================================================
bool isTickSel = str.contains(i_ltf, "tick")
bool isSecSel  = str.contains(i_ltf, "second")

string ltfRaw = i_ltf == "1 second" ? "1S" :
  i_ltf == "5 seconds"   ? "5S" :
  i_ltf == "10 seconds"  ? "10S" :
  i_ltf == "15 seconds"  ? "15S" :
  i_ltf == "30 seconds"  ? "30S" :
  i_ltf == "45 seconds"  ? "45S" :
  i_ltf == "1 minute"    ? "1" :
  i_ltf == "3 minutes"   ? "3" :
  i_ltf == "5 minutes"   ? "5" :
  i_ltf == "15 minutes"  ? "15" :
  i_ltf == "30 minutes"  ? "30" :
  "1"

int chartSecs = timeframe.in_seconds(timeframe.period)
int ltfSecs   = timeframe.in_seconds(ltfRaw)

// Reasons we cannot honour the requested LTF:
//   - chart is 1m or lower, so no minute-based LTF is strictly lower
//   - a tick resolution was chosen (Pine cannot request ticks)
//   - the chosen LTF is not below the chart TF
bool chartTooLow  = chartSecs <= 60
bool ltfNotLower  = ltfSecs >= chartSecs
bool forcedChart  = i_ltf == "Chart" or chartTooLow
bool fellBack     = not forcedChart and (isTickSel or ltfNotLower)

// Always pass a resolution that is guaranteed valid, so the call never errors.
string ltfSafe = "1"
string ltfUsed = forcedChart ? ltfSafe : (fellBack ? ltfSafe : ltfRaw)
bool   useLtf  = not forcedChart

int    ltfUsedSecs   = timeframe.in_seconds(ltfUsed)
int    intrabarsPer  = useLtf and ltfUsedSecs > 0 ? math.max(1, int(chartSecs / ltfUsedSecs)) : 1
int    depthBars     = useLtf ? int(INTRABAR_CAP / intrabarsPer) : 0

// ── anchor ───────────────────────────────────────────────────────────────────
string anchorTf = i_anchor == "1 Week" ? "W" : i_anchor == "1 Month" ? "M" : "D"
bool   newPeriod = i_anchor == "None" ? false : timeframe.change(anchorTf)

// =============================================================================
//  DATA
// -----------------------------------------------------------------------------
//  Both calls are made unconditionally. Two request calls is irrelevant at this
//  phase and it keeps the resolution argument statically valid; Phase 2 will
//  branch so the venue fan-out only pays for the engine it uses.
// =============================================================================
//  ignore_invalid_timeframe is what keeps this safe: on a 1m chart no minute
//  resolution is strictly lower, and on a free plan every seconds resolution is
//  unavailable. Both return na instead of killing the script, and the Status row
//  reports which case we hit.
[ltfO, ltfH, ltfL, ltfC, ltfV] = request.security_lower_tf(venueSym, ltfUsed,
     [open, high, low, close, volume], ignore_invalid_symbol = true,
     ignore_invalid_timeframe = true)

[barO, barH, barL, barC, barV] = request.security(venueSym, timeframe.period,
     [open, high, low, close, volume], ignore_invalid_symbol = true,
     lookahead = barmerge.lookahead_off)

int  nIntra = na(ltfC) ? 0 : array.size(ltfC)
bool ltfOk  = nIntra > 0

// Degrade rather than go blank: if the intrabar request came back empty (plan
// gating, unlisted pair, unusable resolution) fall through to chart-bar delta
// and say so, instead of plotting nothing.
bool useLtfEff = useLtf and ltfOk

// =============================================================================
//  DELTA
// -----------------------------------------------------------------------------
//  Walks intrabars, tracks the running cumulative so the CVD candle gets real
//  wicks, and converts to base units per intrabar (price varies within the bar,
//  so inverse conversion must happen inside the loop, not after).
// =============================================================================
//  The tick rule is a chain: each intrabar's direction is decided against the
//  previous intrabar's close, and a tie inherits the previous direction. That
//  chain must not break at chart-bar boundaries - if it does, the first
//  intrabar of every bar is judged against the wrong reference and any tie
//  there drops that minute's volume entirely. Over a monthly anchor on 4H
//  that is ~180 broken links and a visible drift against the built-in.
var int   dirCarry   = 0    // last direction, carried across bars
var float closeCarry = na   // last intrabar close of the previous bar

float run    = 0.0        // running cumulative within this bar
float runHi  = 0.0        // highest value the running cumulative reached
float runLo  = 0.0        // lowest
int   lastDir = dirCarry  // seed from the previous bar, not from zero

if useLtfEff
    for i = 0 to nIntra - 1
        float o_ = array.get(ltfO, i)
        float h_ = array.get(ltfH, i)
        float l_ = array.get(ltfL, i)
        float c_ = array.get(ltfC, i)
        float v_ = nz(array.get(ltfV, i))

        float d = 0.0
        if i_class == "Proportional"
            float rng = h_ - l_
            d := rng > 0 ? v_ * ((2.0 * (c_ - l_) / rng) - 1.0) : 0.0
            lastDir := d > 0 ? 1 : d < 0 ? -1 : lastDir
        else if i_class == "Tick rule"
            // i == 0 reaches back to the previous chart bar's final close.
            float pc = i > 0 ? array.get(ltfC, i - 1) : nz(closeCarry, o_)
            int dir = c_ > pc ? 1 : c_ < pc ? -1 : lastDir
            lastDir := dir
            d := dir * v_
        else
            int dir = c_ > o_ ? 1 : c_ < o_ ? -1 : 0
            lastDir := dir != 0 ? dir : lastDir
            d := dir * v_

        // to base units
        float dBase = isInverse ? (c_ > 0 ? d * unitMult / c_ : 0.0) : d * unitMult
        run   := run + dBase
        runHi := math.max(runHi, run)
        runLo := math.min(runLo, run)

    // Hand the chain to the next bar.
    closeCarry := array.get(ltfC, nIntra - 1)
    dirCarry   := lastDir

else if not na(barC)
    float v_ = nz(barV)
    float d  = 0.0
    if i_class == "Proportional"
        float rng = barH - barL
        d := rng > 0 ? v_ * ((2.0 * (barC - barL) / rng) - 1.0) : 0.0
    else if i_class == "Tick rule"
        float pc = nz(barC[1], barO)
        d := (barC > pc ? 1 : barC < pc ? -1 : 0) * v_
    else
        d := (barC > barO ? 1 : barC < barO ? -1 : 0) * v_

    float dBase = isInverse ? (barC > 0 ? d * unitMult / barC : 0.0) : d * unitMult
    run   := dBase
    runHi := math.max(0.0, dBase)
    runLo := math.min(0.0, dBase)

float barDelta = run

// ── cumulative with anchor reset ─────────────────────────────────────────────
var float cum = 0.0
if newPeriod
    cum := 0.0

float cvdO = cum
float cvdC = cum + barDelta
float cvdH = cum + runHi                  // runHi >= 0 and >= barDelta
float cvdL = cum + runLo                  // runLo <= 0 and <= barDelta
cum := cvdC

bool hasData = useLtfEff or not na(barC)

// =============================================================================
//  PLOTS
// =============================================================================
bool showCandles = i_mode == "CVD Candles"
bool showLine    = i_mode == "CVD Line"
bool showCols    = i_mode == "Per-bar Delta"

color bodyCol = cvdC >= cvdO ? i_up : i_dn

plotcandle(showCandles and hasData ? cvdO : na,
           showCandles and hasData ? cvdH : na,
           showCandles and hasData ? cvdL : na,
           showCandles and hasData ? cvdC : na,
           title = "CVD Candles", color = bodyCol,
           wickcolor = bodyCol, bordercolor = bodyCol)

plot(showLine and hasData ? cvdC : na, "CVD Line",
     color = bodyCol, linewidth = 2, style = plot.style_line)

plot(showCols and hasData ? barDelta : na, "Per-bar Delta",
     color = barDelta >= 0 ? i_up : i_dn, style = plot.style_columns)

hline(i_zero ? 0 : na, "Zero", color = color.new(color.gray, 55))

// Hidden outputs so a companion script can consume these via input.source().
plot(cvdC,     "Out: CVD",      display = display.none)
plot(barDelta, "Out: Delta",    display = display.none)
plot(nIntra,   "Out: Intrabars", display = display.none)

// =============================================================================
//  DIAGNOSTICS
// =============================================================================
f_abbr(float v) =>
    float a = math.abs(v)
    a >= 1e9 ? str.tostring(v / 1e9, "#.##") + "B" :
      a >= 1e6 ? str.tostring(v / 1e6, "#.##") + "M" :
      a >= 1e3 ? str.tostring(v / 1e3, "#.##") + "K" :
      str.tostring(v, "#.##")

string tblPos = i_tpos == "Top Left" ? position.top_left :
  i_tpos == "Bottom Right" ? position.bottom_right :
  i_tpos == "Bottom Left" ? position.bottom_left :
  i_tpos == "Middle Right" ? position.middle_right :
  position.top_right

var table tbl = table.new(tblPos, 2, 9,
     bgcolor      = color.new(#0b0b0f, 15),
     border_color = color.new(color.gray, 70),
     border_width = 1, frame_width = 1,
     frame_color  = color.new(color.gray, 55))

if i_table and barstate.islast
    color cHdr = color.new(#16202e, 0)
    color cLbl = color.new(color.gray, 20)
    color cVal = color.white

    // Warning takes priority over cosmetics - a silent wrong number is the
    // failure mode this whole phase exists to prevent.
    string warn = ""
    color  warnCol = color.new(color.gray, 30)
    if not hasData
        warn := "NO DATA — pair not listed"
        warnCol := i_dn
    else if useLtf and not ltfOk
        // Most common cause on a free plan: a seconds resolution was requested.
        warn := isSecSel ? "seconds LTF needs Pro+ → chart bar" : "LTF unavailable → chart bar"
        warnCol := i_dn
    else if not isCrypto
        warn := "non-crypto — chart symbol only"
        warnCol := color.orange
    else if isTickSel
        warn := "ticks unavailable in Pine → 1m"
        warnCol := color.orange
    else if chartTooLow
        warn := "chart ≤ 1m → chart bar"
        warnCol := color.orange
    else if fellBack
        warn := "LTF not below chart TF → 1m"
        warnCol := color.orange
    else if useLtfEff and depthBars < 500
        warn := "shallow history ~" + str.tostring(depthBars) + " bars"
        warnCol := color.orange
    else
        warn := "ok"
        warnCol := i_up

    table.cell(tbl, 0, 0, "CVD ENGINE",  text_color = cVal, text_size = size.tiny, bgcolor = cHdr)
    table.cell(tbl, 1, 0, "P1 · parity", text_color = cLbl, text_size = size.tiny, bgcolor = cHdr)

    table.cell(tbl, 0, 1, "Feed",   text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 1, venueSym, text_color = cVal, text_size = size.tiny)

    table.cell(tbl, 0, 2, "CVD",            text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 2, hasData ? f_abbr(cvdC) : "—",
               text_color = cvdC >= 0 ? i_up : i_dn, text_size = size.small)

    table.cell(tbl, 0, 3, "Bar Δ", text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 3, hasData ? f_abbr(barDelta) : "—",
               text_color = barDelta >= 0 ? i_up : i_dn, text_size = size.tiny)

    table.cell(tbl, 0, 4, "Engine", text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 4, useLtfEff ? "intrabar " + ltfUsed : "chart bar",
               text_color = cVal, text_size = size.tiny)

    table.cell(tbl, 0, 5, "Intrabars", text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 5, useLtfEff ? str.tostring(nIntra) + " / bar (≈" + str.tostring(intrabarsPer) + ")" : "n/a",
               text_color = cVal, text_size = size.tiny)

    table.cell(tbl, 0, 6, "Depth", text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 6, useLtfEff ? "~" + str.tostring(depthBars) + " bars" : "full history",
               text_color = cVal, text_size = size.tiny)

    table.cell(tbl, 0, 7, "Rule", text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 7, i_class + " · " + i_anchor, text_color = cVal, text_size = size.tiny)

    table.cell(tbl, 0, 8, "Status", text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 8, warn, text_color = warnCol, text_size = size.tiny)
