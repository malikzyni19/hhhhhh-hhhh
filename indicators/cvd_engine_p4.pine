//@version=6
// =============================================================================
//  CVD ENGINE — PHASE 4: VENUE CONTRIBUTION & LEAD-LAG
// -----------------------------------------------------------------------------
//  A superset of Phase 2. The aggregation engine is unchanged and still
//  validated against the built-in CVD (tick rule). Phase 3 adds the view the
//  whole project was aimed at: seeing spot and perpetual order flow side by
//  side, so a divergence between them is visible rather than inferred.
//
//  Three views:
//    - Single stream : Phase 2 behaviour. Candles / line / columns of the
//                      selected stream (Global / Spot / Perp).
//    - Spot vs Perp  : both streams overlaid as lines. Because perp volume
//                      dwarfs spot, Raw would flatten spot into the baseline
//                      and hide exactly what you are looking for - so the
//                      default is Z-Score, which puts both on a comparable
//                      scale. Raw remains available for true magnitude.
//    - Spot-Perp     : the spread (z_spot - z_perp) as a single histogram.
//                      Divergence becomes one line crossing zero:
//                        > 0  spot leading  (accumulation / squeeze fuel)
//                        < 0  perp leading  (leverage-driven, thinner bid)
//
//  Phase 3 only VISUALISES the divergence. Automatic detection, the
//  liquidation-cascade filter, and alerts are Phase 5.
//
//  The delta math is identical to Phase 1 - it is the f_delta function, called
//  once per venue. The tick-rule carry lives in `var` state inside it; because
//  Pine keeps `var` per call-site, each venue keeps its own chain across bars.
//
//  UNITS: base (coins), matching the built-in. KRW/USDC/USD venues need no FX -
//  volume is already in the base asset. All current venues are linear; f_delta
//  keeps an inverse-contract path for any inverse feed added later.
//
//
//  PHASE 4 adds the per-venue breakdown: which exchange is actually driving the
//  move. All of it is computed from the per-venue deltas Phase 2 already
//  produces, so it costs ZERO additional data requests.
//
//    - Contribution table : one row per active venue, ranked by share of the
//                           anchor period's flow. Venue names are tinted to
//                           match their plot colour, so the table doubles as
//                           the legend (a chart legend is not usable on mobile).
//    - Share %            : each venue's signed slice of total period flow.
//                           Absolute shares sum to 100, so every venue lives on
//                           one comparable axis.
//    - Lead-lag score     : rolling correlation of a venue's PREVIOUS-bar delta
//                           against this bar's price move. Ranks venues by
//                           predictive power rather than coincidence. This is a
//                           heuristic, not proof of causation.
//    - Consensus          : share of active venues agreeing with global
//                           direction. Broad agreement tends to sustain.
//    - Dominance          : the top venue's share. Above ~60% the move is
//                           single-venue driven, which often means a wick or a
//                           liquidation cascade rather than conviction.
//
//  ROBUSTNESS: every request uses ignore_invalid_symbol; correctness for a
//  disabled venue is enforced on its enable flag inside f_delta, not on the
//  symbol, so a disabled or unlisted venue contributes exactly zero.
// =============================================================================

indicator("CVD Engine — P4 Venues", "CVD·P4", overlay = false, format = format.volume, precision = 2)

// ── groups ───────────────────────────────────────────────────────────────────
const string G_ENG = "Engine"
const string G_STR = "Stream & Display"
const string G_SPT = "Spot Venues"
const string G_PRP = "Perp Venues"
const string G_VLN = "Venue Lines"
const string G_CTB = "Dashboard"

const int INTRABAR_CAP = 100000

// ── engine inputs (identical semantics to Phase 1) ───────────────────────────
string i_ltf = input.string("1 minute", "Lower Timeframe", group = G_ENG,
     options = ["Chart",
                  "1 tick", "10 ticks", "100 ticks", "1000 ticks",
                  "1 second", "5 seconds", "10 seconds", "15 seconds", "30 seconds", "45 seconds",
                  "1 minute", "3 minutes", "5 minutes", "15 minutes", "30 minutes"],
     tooltip = "Chart = no intrabar breakdown (cheap, full history, crude delta).\n" +
               "Seconds require Pro+. Ticks are not retrievable from Pine → fall back to 1m.\n\n" +
               "Every enabled venue runs its own intrabar breakdown, so lowering the LTF or " +
               "enabling more venues both increase load. If you hit 'script took too long', " +
               "raise the LTF or disable venues.")

// Tick rule is locked as the default: Phase 1 confirmed it matches the built-in.
// The other two remain available for experimentation and cross-checks.
string i_class = input.string("Tick rule", "Volume Classification", group = G_ENG,
     options = ["Tick rule", "Bar direction", "Proportional"],
     tooltip = "Tick rule matched the built-in CVD in Phase 1 parity testing and is the default.")

string i_anchor = input.string("1 Day", "Anchor Period", group = G_ENG,
     options = ["None", "1 Day", "1 Week", "1 Month"])

// ── view & display ───────────────────────────────────────────────────────────
string i_view = input.string("Spot vs Perp", "View", group = G_STR,
     options = ["Single stream", "Spot vs Perp", "Spot-Perp Spread",
                  "Per-venue Share %", "Per-venue CVD (z)"],
     tooltip = "Single stream: candles/line/columns of one stream (Phase 2 behaviour).\n" +
               "Spot vs Perp: both streams overlaid as lines - the divergence view.\n" +
               "Spot-Perp Spread: their difference as one histogram crossing zero.\n" +
               "Per-venue Share %: each venue's slice of period flow, one comparable axis.\n" +
               "Per-venue CVD (z): each venue's own CVD, z-scored so venues are comparable.\n\n" +
               "Use the contribution table as the legend - venue names are tinted to match " +
               "their line colour.")

string i_stream = input.string("Global", "Single-stream: which", group = G_STR,
     options = ["Global", "Spot", "Perp"],
     tooltip = "Only used by the Single stream view.")

string i_mode = input.string("CVD Candles", "Single-stream: how", group = G_STR,
     options = ["CVD Candles", "CVD Line", "Per-bar Delta"],
     tooltip = "Only used by the Single stream view.")

string i_norm = input.string("Z-Score", "Compare/Spread scaling", group = G_STR,
     options = ["Z-Score", "Raw"],
     tooltip = "Used by the Spot vs Perp and Spread views.\n" +
               "Z-Score puts spot and perp on a comparable scale so divergence is visible - " +
               "perp volume is far larger, so Raw tends to flatten spot into the baseline.")

int i_normLen = input.int(200, "Z-Score window", group = G_STR, minval = 20, maxval = 1000,
     tooltip = "Lookback for the z-score mean and standard deviation.")

color i_spot = input.color(#26c6da, "Spot",  group = G_STR, inline = "sp")
color i_perp = input.color(#ffa726, "Perp",  group = G_STR, inline = "sp")
color i_up   = input.color(#26a69a, "Up",    group = G_STR, inline = "col")
color i_dn   = input.color(#ef5350, "Down",  group = G_STR, inline = "col")
bool  i_zero = input.bool(true, "Zero line", group = G_STR)

// ── venue toggles ────────────────────────────────────────────────────────────
// Defaults are a conservative five-venue set (3 spot + 2 perp) that runs
// comfortably on a free plan. Everything else is one checkbox away; a disabled
// venue skips its intrabar processing (empty symbol) and is force-zeroed in
// f_delta. Hyperliquid tickers are unverified on TradingView - if a feed is not
// listed it simply shows inactive and contributes nothing.
bool en_binS = input.bool(true,  "Binance",     group = G_SPT, inline = "s1")
bool en_cbS  = input.bool(true,  "Coinbase",    group = G_SPT, inline = "s1")
bool en_okS  = input.bool(true,  "OKX",         group = G_SPT, inline = "s2")
bool en_byS  = input.bool(false, "Bybit",       group = G_SPT, inline = "s2")
bool en_krS  = input.bool(false, "Kraken",      group = G_SPT, inline = "s3")
bool en_bgS  = input.bool(false, "Bitget",      group = G_SPT, inline = "s3")
bool en_gtS  = input.bool(true,  "Gate.io",     group = G_SPT, inline = "s4")
bool en_htS  = input.bool(true,  "HTX",         group = G_SPT, inline = "s4")
bool en_mxS  = input.bool(false, "MEXC",        group = G_SPT, inline = "s5")
bool en_hlS  = input.bool(false, "Hyperliquid", group = G_SPT, inline = "s5")

bool en_binP = input.bool(true,  "Binance",     group = G_PRP, inline = "p1")
bool en_byP  = input.bool(true,  "Bybit",       group = G_PRP, inline = "p1")
bool en_okP  = input.bool(false, "OKX",         group = G_PRP, inline = "p2")
bool en_bgP  = input.bool(false, "Bitget",      group = G_PRP, inline = "p2")
bool en_hlP  = input.bool(false, "Hyperliquid", group = G_PRP, inline = "p3")
bool en_mxP  = input.bool(false, "MEXC",        group = G_PRP, inline = "p3")

int i_leadLen = input.int(100, "Lead-lag window", group = G_STR, minval = 20, maxval = 500,
     tooltip = "Lookback for the lead-lag correlation. Longer is steadier but slower to react.")

// ── per-venue line controls ──────────────────────────────────────────────────
int  i_topLines = input.int(4, "Venue lines to draw", group = G_VLN, minval = 1, maxval = 16,
     tooltip = "Used by the Per-venue views. Only the largest venues are drawn, so the pane " +
               "stays readable.\n\n" +
               "Selection is by LIFETIME volume, not by the current period. That is deliberate: " +
               "ranking by the current period would make lines appear and vanish mid-chart as " +
               "the order changed. Lifetime volume is slow-moving, so each line keeps a stable " +
               "identity and colour across the whole chart. Use the table to see who is driving " +
               "right now.")
bool i_venSpot = input.bool(true, "Spot venues", group = G_VLN, inline = "vl")
bool i_venPerp = input.bool(true, "Perp venues", group = G_VLN, inline = "vl")

// ── dashboard ────────────────────────────────────────────────────────────────
// One dashboard at a time. The pane is narrow, so the venue table REPLACES the
// diagnostics table whenever a Per-venue view is active, rather than stacking.
bool   i_dash = input.bool(true, "Show dashboard", group = G_CTB,
     tooltip = "Per-venue views show the exchange contribution table; every other view shows " +
               "the diagnostics table. Only ever one at a time.")
string i_dpos = input.string("Top Right", "Position", group = G_CTB,
     options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"])
int    i_topN = input.int(5, "Table rows", group = G_CTB, minval = 1, maxval = 16,
     tooltip = "How many venues to list, ranked by share of the CURRENT period's flow - so the " +
               "table is responsive even though the lines are stable.")
bool   i_showAll = input.bool(false, "List all active venues", group = G_CTB)

// =============================================================================
//  SYMBOL CONSTRUCTION
// -----------------------------------------------------------------------------
//  Built from syminfo.basecurrency, so this works on any pair. A disabled venue
//  resolves to "" to skip the intrabar fetch cost; the enable flag passed to
//  f_delta is what actually guarantees a zero contribution.
// =============================================================================
bool   isCrypto = syminfo.type == "crypto"
string base  = syminfo.basecurrency
string baseX = base == "BTC" ? "XBT" : base          // Kraken BTC alias (XBT)

f_sym(bool en, string s) => en and isCrypto ? s : ""

string sBinS = f_sym(en_binS, "BINANCE:"     + base  + "USDT")
string sCbS  = f_sym(en_cbS,  "COINBASE:"    + base  + "USD")
string sOkS  = f_sym(en_okS,  "OKX:"         + base  + "USDT")
string sByS  = f_sym(en_byS,  "BYBIT:"       + base  + "USDT")
string sKrS  = f_sym(en_krS,  "KRAKEN:"      + baseX + "USD")
string sBgS  = f_sym(en_bgS,  "BITGET:"      + base  + "USDT")
string sMxS  = f_sym(en_mxS,  "MEXC:"        + base  + "USDT")
string sGtS  = f_sym(en_gtS,  "GATEIO:"      + base  + "USDT")
string sHtS  = f_sym(en_htS,  "HTX:"         + base  + "USDT")   // if inactive, try HUOBI:
string sHlS  = f_sym(en_hlS,  "HYPERLIQUID:" + base  + "USDC")   // unverified ticker

string sBinP = f_sym(en_binP, "BINANCE:"     + base  + "USDT.P")
string sByP  = f_sym(en_byP,  "BYBIT:"       + base  + "USDT.P")
string sOkP  = f_sym(en_okP,  "OKX:"         + base  + "USDT.P")
string sBgP  = f_sym(en_bgP,  "BITGET:"      + base  + "USDT.P")
string sHlP  = f_sym(en_hlP,  "HYPERLIQUID:" + base  + "USDC.P") // unverified ticker
string sMxP  = f_sym(en_mxP,  "MEXC:"        + base  + "USDT.P")  // unverified ticker

// =============================================================================
//  TIMEFRAME RESOLUTION (identical logic to Phase 1)
// =============================================================================
bool isTickSel = str.contains(i_ltf, "tick")
bool isSecSel  = str.contains(i_ltf, "second")

string ltfRaw = i_ltf == "1 second" ? "1S" :
  i_ltf == "5 seconds"   ? "5S" :
  i_ltf == "10 seconds"  ? "10S" :
  i_ltf == "15 seconds"  ? "15S" :
  i_ltf == "30 seconds"  ? "30S" :
  i_ltf == "45 seconds"  ? "45S" :
  i_ltf == "1 minute"    ? "1" :
  i_ltf == "3 minutes"   ? "3" :
  i_ltf == "5 minutes"   ? "5" :
  i_ltf == "15 minutes"  ? "15" :
  i_ltf == "30 minutes"  ? "30" :
  "1"

int  chartSecs   = timeframe.in_seconds(timeframe.period)
int  ltfSecs     = timeframe.in_seconds(ltfRaw)
bool chartTooLow = chartSecs <= 60
bool ltfNotLower = ltfSecs >= chartSecs
bool forcedChart = i_ltf == "Chart" or chartTooLow
bool fellBack    = not forcedChart and (isTickSel or ltfNotLower)

string ltfUsed = forcedChart ? "1" : (fellBack ? "1" : ltfRaw)
bool   useLtf  = not forcedChart

int ltfUsedSecs = timeframe.in_seconds(ltfUsed)
int intrabarsPer = useLtf and ltfUsedSecs > 0 ? math.max(1, int(chartSecs / ltfUsedSecs)) : 1
int depthBars    = useLtf ? int(INTRABAR_CAP / intrabarsPer) : 0

string anchorTf  = i_anchor == "1 Week" ? "W" : i_anchor == "1 Month" ? "M" : "D"
bool   newPeriod = i_anchor == "None" ? false : timeframe.change(anchorTf)

// =============================================================================
//  DELTA FUNCTION
// -----------------------------------------------------------------------------
//  The Phase 1 delta engine, verbatim in behaviour, wrapped so it can be reused
//  per venue. Returns [barDelta, runHi, runLo, hasData]. The tick-rule carry is
//  `var` inside the function, so each of the 13 call-sites keeps its own chain.
//
//  runHi >= 0 and runLo <= 0 by construction, and both bracket barDelta, so the
//  per-venue candle wick always contains its own open and close.
// =============================================================================
f_delta(bool en, array<float> aO, array<float> aH, array<float> aL, array<float> aC, array<float> aV,
        float bO, float bH, float bL, float bC, float bV,
        bool useL, simple string rule, bool inv, float mult) =>
    var int   dCarry = 0
    var float cCarry = na

    int  nn     = na(aC) ? 0 : array.size(aC)
    // A disabled venue must contribute exactly zero regardless of what the
    // request returned. Empty-symbol requests do not reliably return na - they
    // can fall back to the chart symbol and leak its data into the aggregate -
    // so correctness is enforced here, on the enable flag, not on the symbol.
    bool useArr = en and useL and nn > 0

    float run = 0.0
    float hi  = 0.0
    float lo  = 0.0
    int   ld  = dCarry

    if useArr
        for i = 0 to nn - 1
            float o_ = array.get(aO, i)
            float h_ = array.get(aH, i)
            float l_ = array.get(aL, i)
            float c_ = array.get(aC, i)
            float v_ = nz(array.get(aV, i))

            float d = 0.0
            if rule == "Proportional"
                float rng = h_ - l_
                d := rng > 0 ? v_ * ((2.0 * (c_ - l_) / rng) - 1.0) : 0.0
                ld := d > 0 ? 1 : d < 0 ? -1 : ld
            else if rule == "Bar direction"
                int dir = c_ > o_ ? 1 : c_ < o_ ? -1 : 0
                ld := dir != 0 ? dir : ld
                d := dir * v_
            else
                float pc = i > 0 ? array.get(aC, i - 1) : nz(cCarry, o_)
                int dir = c_ > pc ? 1 : c_ < pc ? -1 : ld
                ld := dir
                d := dir * v_

            float dBase = inv ? (c_ > 0 ? d * mult / c_ : 0.0) : d * mult
            run := run + dBase
            hi  := math.max(hi, run)
            lo  := math.min(lo, run)

        cCarry := array.get(aC, nn - 1)
        dCarry := ld
        [run, hi, lo, true]
    else if en and not na(bC)
        float v_ = nz(bV)
        float d  = 0.0
        if rule == "Proportional"
            float rng = bH - bL
            d := rng > 0 ? v_ * ((2.0 * (bC - bL) / rng) - 1.0) : 0.0
        else if rule == "Bar direction"
            d := (bC > bO ? 1 : bC < bO ? -1 : 0) * v_
        else
            float pc = nz(bC[1], bO)
            d := (bC > pc ? 1 : bC < pc ? -1 : 0) * v_
        float dBase = inv ? (bC > 0 ? d * mult / bC : 0.0) : d * mult
        [dBase, math.max(0.0, dBase), math.min(0.0, dBase), true]
    else
        [0.0, 0.0, 0.0, false]

// =============================================================================
//  DATA + PER-VENUE DELTA
// -----------------------------------------------------------------------------
//  One intrabar request and one chart-bar request per venue, all at global
//  scope. The request calls are NOT wrapped in a helper function: request.* wants
//  a `simple string` symbol, and passing the symbol through a function parameter
//  can demote it to `series`, which fails to compile. Inlining keeps every
//  symbol simple. 16 venues × 2 = 32 calls, within the 40-call budget. Disabled
//  venues carry an empty symbol, so their requests return na and f_delta
//  short-circuits to a zero result.
//
//  request.security_lower_tf always uses the [O,H,L,C,V] tuple; the chart-bar
//  request mirrors it so f_delta receives a consistent shape.
// =============================================================================
[lBinS_o, lBinS_h, lBinS_l, lBinS_c, lBinS_v] = request.security_lower_tf(sBinS, ltfUsed, [open, high, low, close, volume], ignore_invalid_symbol = true, ignore_invalid_timeframe = true)
[bBinS_o, bBinS_h, bBinS_l, bBinS_c, bBinS_v] = request.security(sBinS, timeframe.period, [open, high, low, close, volume], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
[dBinS, hBinS, loBinS, okBinS] = f_delta(en_binS, lBinS_o, lBinS_h, lBinS_l, lBinS_c, lBinS_v, bBinS_o, bBinS_h, bBinS_l, bBinS_c, bBinS_v, useLtf, i_class, false, 1.0)

[lCbS_o, lCbS_h, lCbS_l, lCbS_c, lCbS_v] = request.security_lower_tf(sCbS, ltfUsed, [open, high, low, close, volume], ignore_invalid_symbol = true, ignore_invalid_timeframe = true)
[bCbS_o, bCbS_h, bCbS_l, bCbS_c, bCbS_v] = request.security(sCbS, timeframe.period, [open, high, low, close, volume], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
[dCbS, hCbS, loCbS, okCbS] = f_delta(en_cbS, lCbS_o, lCbS_h, lCbS_l, lCbS_c, lCbS_v, bCbS_o, bCbS_h, bCbS_l, bCbS_c, bCbS_v, useLtf, i_class, false, 1.0)

[lOkS_o, lOkS_h, lOkS_l, lOkS_c, lOkS_v] = request.security_lower_tf(sOkS, ltfUsed, [open, high, low, close, volume], ignore_invalid_symbol = true, ignore_invalid_timeframe = true)
[bOkS_o, bOkS_h, bOkS_l, bOkS_c, bOkS_v] = request.security(sOkS, timeframe.period, [open, high, low, close, volume], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
[dOkS, hOkS, loOkS, okOkS] = f_delta(en_okS, lOkS_o, lOkS_h, lOkS_l, lOkS_c, lOkS_v, bOkS_o, bOkS_h, bOkS_l, bOkS_c, bOkS_v, useLtf, i_class, false, 1.0)

[lByS_o, lByS_h, lByS_l, lByS_c, lByS_v] = request.security_lower_tf(sByS, ltfUsed, [open, high, low, close, volume], ignore_invalid_symbol = true, ignore_invalid_timeframe = true)
[bByS_o, bByS_h, bByS_l, bByS_c, bByS_v] = request.security(sByS, timeframe.period, [open, high, low, close, volume], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
[dByS, hByS, loByS, okByS] = f_delta(en_byS, lByS_o, lByS_h, lByS_l, lByS_c, lByS_v, bByS_o, bByS_h, bByS_l, bByS_c, bByS_v, useLtf, i_class, false, 1.0)

[lKrS_o, lKrS_h, lKrS_l, lKrS_c, lKrS_v] = request.security_lower_tf(sKrS, ltfUsed, [open, high, low, close, volume], ignore_invalid_symbol = true, ignore_invalid_timeframe = true)
[bKrS_o, bKrS_h, bKrS_l, bKrS_c, bKrS_v] = request.security(sKrS, timeframe.period, [open, high, low, close, volume], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
[dKrS, hKrS, loKrS, okKrS] = f_delta(en_krS, lKrS_o, lKrS_h, lKrS_l, lKrS_c, lKrS_v, bKrS_o, bKrS_h, bKrS_l, bKrS_c, bKrS_v, useLtf, i_class, false, 1.0)

[lBgS_o, lBgS_h, lBgS_l, lBgS_c, lBgS_v] = request.security_lower_tf(sBgS, ltfUsed, [open, high, low, close, volume], ignore_invalid_symbol = true, ignore_invalid_timeframe = true)
[bBgS_o, bBgS_h, bBgS_l, bBgS_c, bBgS_v] = request.security(sBgS, timeframe.period, [open, high, low, close, volume], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
[dBgS, hBgS, loBgS, okBgS] = f_delta(en_bgS, lBgS_o, lBgS_h, lBgS_l, lBgS_c, lBgS_v, bBgS_o, bBgS_h, bBgS_l, bBgS_c, bBgS_v, useLtf, i_class, false, 1.0)


[lHlS_o, lHlS_h, lHlS_l, lHlS_c, lHlS_v] = request.security_lower_tf(sHlS, ltfUsed, [open, high, low, close, volume], ignore_invalid_symbol = true, ignore_invalid_timeframe = true)
[bHlS_o, bHlS_h, bHlS_l, bHlS_c, bHlS_v] = request.security(sHlS, timeframe.period, [open, high, low, close, volume], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
[dHlS, hHlS, loHlS, okHlS] = f_delta(en_hlS, lHlS_o, lHlS_h, lHlS_l, lHlS_c, lHlS_v, bHlS_o, bHlS_h, bHlS_l, bHlS_c, bHlS_v, useLtf, i_class, false, 1.0)

[lMxS_o, lMxS_h, lMxS_l, lMxS_c, lMxS_v] = request.security_lower_tf(sMxS, ltfUsed, [open, high, low, close, volume], ignore_invalid_symbol = true, ignore_invalid_timeframe = true)
[bMxS_o, bMxS_h, bMxS_l, bMxS_c, bMxS_v] = request.security(sMxS, timeframe.period, [open, high, low, close, volume], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
[dMxS, hMxS, loMxS, okMxS] = f_delta(en_mxS, lMxS_o, lMxS_h, lMxS_l, lMxS_c, lMxS_v, bMxS_o, bMxS_h, bMxS_l, bMxS_c, bMxS_v, useLtf, i_class, false, 1.0)

[lGtS_o, lGtS_h, lGtS_l, lGtS_c, lGtS_v] = request.security_lower_tf(sGtS, ltfUsed, [open, high, low, close, volume], ignore_invalid_symbol = true, ignore_invalid_timeframe = true)
[bGtS_o, bGtS_h, bGtS_l, bGtS_c, bGtS_v] = request.security(sGtS, timeframe.period, [open, high, low, close, volume], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
[dGtS, hGtS, loGtS, okGtS] = f_delta(en_gtS, lGtS_o, lGtS_h, lGtS_l, lGtS_c, lGtS_v, bGtS_o, bGtS_h, bGtS_l, bGtS_c, bGtS_v, useLtf, i_class, false, 1.0)

[lHtS_o, lHtS_h, lHtS_l, lHtS_c, lHtS_v] = request.security_lower_tf(sHtS, ltfUsed, [open, high, low, close, volume], ignore_invalid_symbol = true, ignore_invalid_timeframe = true)
[bHtS_o, bHtS_h, bHtS_l, bHtS_c, bHtS_v] = request.security(sHtS, timeframe.period, [open, high, low, close, volume], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
[dHtS, hHtS, loHtS, okHtS] = f_delta(en_htS, lHtS_o, lHtS_h, lHtS_l, lHtS_c, lHtS_v, bHtS_o, bHtS_h, bHtS_l, bHtS_c, bHtS_v, useLtf, i_class, false, 1.0)



[lBinP_o, lBinP_h, lBinP_l, lBinP_c, lBinP_v] = request.security_lower_tf(sBinP, ltfUsed, [open, high, low, close, volume], ignore_invalid_symbol = true, ignore_invalid_timeframe = true)
[bBinP_o, bBinP_h, bBinP_l, bBinP_c, bBinP_v] = request.security(sBinP, timeframe.period, [open, high, low, close, volume], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
[dBinP, hBinP, loBinP, okBinP] = f_delta(en_binP, lBinP_o, lBinP_h, lBinP_l, lBinP_c, lBinP_v, bBinP_o, bBinP_h, bBinP_l, bBinP_c, bBinP_v, useLtf, i_class, false, 1.0)

[lByP_o, lByP_h, lByP_l, lByP_c, lByP_v] = request.security_lower_tf(sByP, ltfUsed, [open, high, low, close, volume], ignore_invalid_symbol = true, ignore_invalid_timeframe = true)
[bByP_o, bByP_h, bByP_l, bByP_c, bByP_v] = request.security(sByP, timeframe.period, [open, high, low, close, volume], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
[dByP, hByP, loByP, okByP] = f_delta(en_byP, lByP_o, lByP_h, lByP_l, lByP_c, lByP_v, bByP_o, bByP_h, bByP_l, bByP_c, bByP_v, useLtf, i_class, false, 1.0)

[lOkP_o, lOkP_h, lOkP_l, lOkP_c, lOkP_v] = request.security_lower_tf(sOkP, ltfUsed, [open, high, low, close, volume], ignore_invalid_symbol = true, ignore_invalid_timeframe = true)
[bOkP_o, bOkP_h, bOkP_l, bOkP_c, bOkP_v] = request.security(sOkP, timeframe.period, [open, high, low, close, volume], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
[dOkP, hOkP, loOkP, okOkP] = f_delta(en_okP, lOkP_o, lOkP_h, lOkP_l, lOkP_c, lOkP_v, bOkP_o, bOkP_h, bOkP_l, bOkP_c, bOkP_v, useLtf, i_class, false, 1.0)

[lBgP_o, lBgP_h, lBgP_l, lBgP_c, lBgP_v] = request.security_lower_tf(sBgP, ltfUsed, [open, high, low, close, volume], ignore_invalid_symbol = true, ignore_invalid_timeframe = true)
[bBgP_o, bBgP_h, bBgP_l, bBgP_c, bBgP_v] = request.security(sBgP, timeframe.period, [open, high, low, close, volume], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
[dBgP, hBgP, loBgP, okBgP] = f_delta(en_bgP, lBgP_o, lBgP_h, lBgP_l, lBgP_c, lBgP_v, bBgP_o, bBgP_h, bBgP_l, bBgP_c, bBgP_v, useLtf, i_class, false, 1.0)

[lHlP_o, lHlP_h, lHlP_l, lHlP_c, lHlP_v] = request.security_lower_tf(sHlP, ltfUsed, [open, high, low, close, volume], ignore_invalid_symbol = true, ignore_invalid_timeframe = true)
[bHlP_o, bHlP_h, bHlP_l, bHlP_c, bHlP_v] = request.security(sHlP, timeframe.period, [open, high, low, close, volume], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
[dHlP, hHlP, loHlP, okHlP] = f_delta(en_hlP, lHlP_o, lHlP_h, lHlP_l, lHlP_c, lHlP_v, bHlP_o, bHlP_h, bHlP_l, bHlP_c, bHlP_v, useLtf, i_class, false, 1.0)

[lMxP_o, lMxP_h, lMxP_l, lMxP_c, lMxP_v] = request.security_lower_tf(sMxP, ltfUsed, [open, high, low, close, volume], ignore_invalid_symbol = true, ignore_invalid_timeframe = true)
[bMxP_o, bMxP_h, bMxP_l, bMxP_c, bMxP_v] = request.security(sMxP, timeframe.period, [open, high, low, close, volume], ignore_invalid_symbol = true, lookahead = barmerge.lookahead_off)
[dMxP, hMxP, loMxP, okMxP] = f_delta(en_mxP, lMxP_o, lMxP_h, lMxP_l, lMxP_c, lMxP_v, bMxP_o, bMxP_h, bMxP_l, bMxP_c, bMxP_v, useLtf, i_class, false, 1.0)

// =============================================================================
//  STREAM AGGREGATION
// -----------------------------------------------------------------------------
//  Missing/disabled venues already returned zeros, so the sums are na-safe. The
//  aggregate candle's wick is the sum of per-venue running extremes: this is an
//  upper envelope (it assumes every venue peaks simultaneously) but it always
//  contains the true open and close, so it never misleads on direction.
// =============================================================================
float spotBar = dBinS + dCbS + dOkS + dByS + dKrS + dBgS + dGtS + dHtS + dMxS + dHlS
float spotHi  = hBinS + hCbS + hOkS + hByS + hKrS + hBgS + hGtS + hHtS + hMxS + hHlS
float spotLo  = loBinS + loCbS + loOkS + loByS + loKrS + loBgS + loGtS + loHtS + loMxS + loHlS

float perpBar = dBinP + dByP + dOkP + dBgP + dHlP + dMxP
float perpHi  = hBinP + hByP + hOkP + hBgP + hHlP + hMxP
float perpLo  = loBinP + loByP + loOkP + loBgP + loHlP + loMxP

float glblBar = spotBar + perpBar
float glblHi  = spotHi + perpHi
float glblLo  = spotLo + perpLo

// active-venue counts (venues that actually returned data this bar)
int spotActive = (okBinS ? 1 : 0) + (okCbS ? 1 : 0) + (okOkS ? 1 : 0) + (okByS ? 1 : 0) + (okKrS ? 1 : 0) +
  (okBgS ? 1 : 0) + (okGtS ? 1 : 0) + (okHtS ? 1 : 0) + (okMxS ? 1 : 0) + (okHlS ? 1 : 0)
int perpActive = (okBinP ? 1 : 0) + (okByP ? 1 : 0) + (okOkP ? 1 : 0) + (okBgP ? 1 : 0) + (okHlP ? 1 : 0) + (okMxP ? 1 : 0)

int spotEnabled = (en_binS ? 1 : 0) + (en_cbS ? 1 : 0) + (en_okS ? 1 : 0) + (en_byS ? 1 : 0) + (en_krS ? 1 : 0) +
  (en_bgS ? 1 : 0) + (en_gtS ? 1 : 0) + (en_htS ? 1 : 0) + (en_mxS ? 1 : 0) + (en_hlS ? 1 : 0)
int perpEnabled = (en_binP ? 1 : 0) + (en_byP ? 1 : 0) + (en_okP ? 1 : 0) + (en_bgP ? 1 : 0) + (en_hlP ? 1 : 0) + (en_mxP ? 1 : 0)

int reqUsed = 2 * (16)          // 16 venues × (intrabar + chart-bar) request

// ── select the displayed stream ──────────────────────────────────────────────
float selBar = i_stream == "Spot" ? spotBar : i_stream == "Perp" ? perpBar : glblBar
float selHi  = i_stream == "Spot" ? spotHi  : i_stream == "Perp" ? perpHi  : glblHi
float selLo  = i_stream == "Spot" ? spotLo  : i_stream == "Perp" ? perpLo  : glblLo
int   selAct = i_stream == "Spot" ? spotActive : i_stream == "Perp" ? perpActive : spotActive + perpActive
int   selEn  = i_stream == "Spot" ? spotEnabled : i_stream == "Perp" ? perpEnabled : spotEnabled + perpEnabled

// ── cumulative with anchor reset ─────────────────────────────────────────────
// barsSinceReset is a diagnostic: if the anchor is working, it climbs through
// the period then snaps to 0. A value in the thousands means the reset is not
// firing and the cumulative is drifting over the whole history.
var float cumSpot = 0.0
var float cumPerp = 0.0
var float cumGlbl = 0.0
var int   barsSinceReset = 0
barsSinceReset := barsSinceReset + 1
if newPeriod
    cumSpot := 0.0
    cumPerp := 0.0
    cumGlbl := 0.0
    barsSinceReset := 0

// track all three so the hidden outputs stay live regardless of what is shown
float spotC = cumSpot + spotBar
float perpC = cumPerp + perpBar
float glblC = cumGlbl + glblBar
cumSpot := spotC
cumPerp := perpC
cumGlbl := glblC

// displayed stream's candle, rebuilt from the pre-update cumulative
float baseCum = i_stream == "Spot" ? (spotC - spotBar) : i_stream == "Perp" ? (perpC - perpBar) : (glblC - glblBar)
float cvdO = baseCum
float cvdC = baseCum + selBar
float cvdH = baseCum + selHi
float cvdL = baseCum + selLo

bool anyData     = selAct > 0
bool anySpot     = spotActive > 0
bool anyPerp     = perpActive > 0
bool anyCompare  = anySpot or anyPerp

// =============================================================================
//  NORMALISATION (Compare / Spread views)
// -----------------------------------------------------------------------------
//  Spot and perp cumulative streams live on very different scales, so the raw
//  overlay hides divergence. The z-score expresses each stream as standard
//  deviations from its own recent mean, which is unit-free and comparable. The
//  spread of the two z-scores is the divergence signal.
// =============================================================================
f_z(float src, int len) =>
    float m = ta.sma(src, len)
    float s = ta.stdev(src, len)
    s > 0 ? (src - m) / s : 0.0

float zSpot = f_z(spotC, i_normLen)
float zPerp = f_z(perpC, i_normLen)

bool useZ = i_norm == "Z-Score"
// Compare lines: z-scored (comparable) or raw cumulative (true magnitude).
float cmpSpot = useZ ? zSpot : spotC
float cmpPerp = useZ ? zPerp : perpC
// Spread is only meaningful on the comparable (z-scored) streams.
float spread  = zSpot - zPerp

// =============================================================================
//  PHASE 4 — PER-VENUE CONTRIBUTION & LEAD-LAG
// -----------------------------------------------------------------------------
//  No new requests: everything below derives from the per-venue deltas already
//  computed above.
//
//  f_cum keeps its accumulator in `var` state, and Pine keeps `var` per
//  call-site, so each of the 16 calls maintains an independent anchor-reset
//  cumulative. Returning a real series (rather than holding these in an array)
//  is deliberate: ta.sma/ta.stdev/ta.correlation need series inputs and cannot
//  operate on array elements.
// =============================================================================
f_cum(float d, bool rst) =>
    var float c = 0.0
    if rst
        c := 0.0
    c := c + d
    c

// per-venue anchor-reset cumulative CVD
float cBinS = f_cum(dBinS, newPeriod)
float cCbS = f_cum(dCbS, newPeriod)
float cOkS = f_cum(dOkS, newPeriod)
float cByS = f_cum(dByS, newPeriod)
float cKrS = f_cum(dKrS, newPeriod)
float cBgS = f_cum(dBgS, newPeriod)
float cHlS = f_cum(dHlS, newPeriod)
float cMxS = f_cum(dMxS, newPeriod)
float cGtS = f_cum(dGtS, newPeriod)
float cHtS = f_cum(dHtS, newPeriod)
float cBinP = f_cum(dBinP, newPeriod)
float cByP = f_cum(dByP, newPeriod)
float cOkP = f_cum(dOkP, newPeriod)
float cBgP = f_cum(dBgP, newPeriod)
float cHlP = f_cum(dHlP, newPeriod)
float cMxP = f_cum(dMxP, newPeriod)

// Total absolute period flow across venues - the denominator for share.
float totAbs = math.abs(cBinS) +
  math.abs(cCbS) +
  math.abs(cOkS) +
  math.abs(cByS) +
  math.abs(cKrS) +
  math.abs(cBgS) +
  math.abs(cGtS) +
  math.abs(cHtS) +
  math.abs(cMxS) +
  math.abs(cHlS) +
  math.abs(cBinP) +
  math.abs(cByP) +
  math.abs(cOkP) +
  math.abs(cBgP) +
  math.abs(cHlP) +
  math.abs(cMxP)

// Signed share of period flow, in percent. Absolute shares sum to 100, so all
// venues sit on one comparable axis regardless of how large the venue is.
float shBinS = totAbs > 0 ? 100.0 * cBinS / totAbs : 0.0
float shCbS = totAbs > 0 ? 100.0 * cCbS / totAbs : 0.0
float shOkS = totAbs > 0 ? 100.0 * cOkS / totAbs : 0.0
float shByS = totAbs > 0 ? 100.0 * cByS / totAbs : 0.0
float shKrS = totAbs > 0 ? 100.0 * cKrS / totAbs : 0.0
float shBgS = totAbs > 0 ? 100.0 * cBgS / totAbs : 0.0
float shHlS = totAbs > 0 ? 100.0 * cHlS / totAbs : 0.0
float shMxS = totAbs > 0 ? 100.0 * cMxS / totAbs : 0.0
float shGtS = totAbs > 0 ? 100.0 * cGtS / totAbs : 0.0
float shHtS = totAbs > 0 ? 100.0 * cHtS / totAbs : 0.0
float shBinP = totAbs > 0 ? 100.0 * cBinP / totAbs : 0.0
float shByP = totAbs > 0 ? 100.0 * cByP / totAbs : 0.0
float shOkP = totAbs > 0 ? 100.0 * cOkP / totAbs : 0.0
float shBgP = totAbs > 0 ? 100.0 * cBgP / totAbs : 0.0
float shHlP = totAbs > 0 ? 100.0 * cHlP / totAbs : 0.0
float shMxP = totAbs > 0 ? 100.0 * cMxP / totAbs : 0.0

// Each venue's cumulative CVD, z-scored so venues of different size compare.
float zcBinS = f_z(cBinS, i_normLen)
float zcCbS = f_z(cCbS, i_normLen)
float zcOkS = f_z(cOkS, i_normLen)
float zcByS = f_z(cByS, i_normLen)
float zcKrS = f_z(cKrS, i_normLen)
float zcBgS = f_z(cBgS, i_normLen)
float zcHlS = f_z(cHlS, i_normLen)
float zcMxS = f_z(cMxS, i_normLen)
float zcGtS = f_z(cGtS, i_normLen)
float zcHtS = f_z(cHtS, i_normLen)
float zcBinP = f_z(cBinP, i_normLen)
float zcByP = f_z(cByP, i_normLen)
float zcOkP = f_z(cOkP, i_normLen)
float zcBgP = f_z(cBgP, i_normLen)
float zcHlP = f_z(cHlP, i_normLen)
float zcMxP = f_z(cMxP, i_normLen)

// Is this venue unusually active for itself right now (z-score of its delta).
float dzBinS = f_z(dBinS, i_normLen)
float dzCbS = f_z(dCbS, i_normLen)
float dzOkS = f_z(dOkS, i_normLen)
float dzByS = f_z(dByS, i_normLen)
float dzKrS = f_z(dKrS, i_normLen)
float dzBgS = f_z(dBgS, i_normLen)
float dzHlS = f_z(dHlS, i_normLen)
float dzMxS = f_z(dMxS, i_normLen)
float dzGtS = f_z(dGtS, i_normLen)
float dzHtS = f_z(dHtS, i_normLen)
float dzBinP = f_z(dBinP, i_normLen)
float dzByP = f_z(dByP, i_normLen)
float dzOkP = f_z(dOkP, i_normLen)
float dzBgP = f_z(dBgP, i_normLen)
float dzHlP = f_z(dHlP, i_normLen)
float dzMxP = f_z(dMxP, i_normLen)

// Lead-lag: correlate the venue's PREVIOUS-bar delta with this bar's return, so
// we measure predictive power rather than coincidence. Heuristic, not causation.
float barRet = nz((close - close[1]) / close[1])
float ldBinS = ta.correlation(dBinS[1], barRet, i_leadLen)
float ldCbS = ta.correlation(dCbS[1], barRet, i_leadLen)
float ldOkS = ta.correlation(dOkS[1], barRet, i_leadLen)
float ldByS = ta.correlation(dByS[1], barRet, i_leadLen)
float ldKrS = ta.correlation(dKrS[1], barRet, i_leadLen)
float ldBgS = ta.correlation(dBgS[1], barRet, i_leadLen)
float ldHlS = ta.correlation(dHlS[1], barRet, i_leadLen)
float ldMxS = ta.correlation(dMxS[1], barRet, i_leadLen)
float ldGtS = ta.correlation(dGtS[1], barRet, i_leadLen)
float ldHtS = ta.correlation(dHtS[1], barRet, i_leadLen)
float ldBinP = ta.correlation(dBinP[1], barRet, i_leadLen)
float ldByP = ta.correlation(dByP[1], barRet, i_leadLen)
float ldOkP = ta.correlation(dOkP[1], barRet, i_leadLen)
float ldBgP = ta.correlation(dBgP[1], barRet, i_leadLen)
float ldHlP = ta.correlation(dHlP[1], barRet, i_leadLen)
float ldMxP = ta.correlation(dMxP[1], barRet, i_leadLen)

// ── ranking ──────────────────────────────────────────────────────────────────
// Inactive venues get -1 so a descending sort sinks them below every active one.
var array<string> vName = array.from("Binance·S", "Coinbase·S", "OKX·S", "Bybit·S", "Kraken·S", "Bitget·S", "Gate·S", "HTX·S", "MEXC·S", "Hyperliq·S", "Binance·P", "Bybit·P", "OKX·P", "Bitget·P", "Hyperliq·P", "MEXC·P")
var array<color>  vCol  = array.from(#f0b90b, #2962ff, #00e5ff, #ff7043, #7e57c2, #26c6da, #5c6bc0, #a1887f, #d4e157, #26a69a, #ffca28, #ff8a65, #4dd0e1, #4db6ac, #9ccc65, #c0ca33)
array<float> vShare = array.from(shBinS, shCbS, shOkS, shByS, shKrS, shBgS, shGtS, shHtS, shMxS, shHlS, shBinP, shByP, shOkP, shBgP, shHlP, shMxP)
array<float> vDelta = array.from(dBinS, dCbS, dOkS, dByS, dKrS, dBgS, dGtS, dHtS, dMxS, dHlS, dBinP, dByP, dOkP, dBgP, dHlP, dMxP)
array<float> vCumv = array.from(cBinS, cCbS, cOkS, cByS, cKrS, cBgS, cGtS, cHtS, cMxS, cHlS, cBinP, cByP, cOkP, cBgP, cHlP, cMxP)
array<float> vDz = array.from(dzBinS, dzCbS, dzOkS, dzByS, dzKrS, dzBgS, dzGtS, dzHtS, dzMxS, dzHlS, dzBinP, dzByP, dzOkP, dzBgP, dzHlP, dzMxP)
array<float> vLead = array.from(ldBinS, ldCbS, ldOkS, ldByS, ldKrS, ldBgS, ldGtS, ldHtS, ldMxS, ldHlS, ldBinP, ldByP, ldOkP, ldBgP, ldHlP, ldMxP)
array<bool>  vAct = array.from(okBinS, okCbS, okOkS, okByS, okKrS, okBgS, okGtS, okHtS, okMxS, okHlS, okBinP, okByP, okOkP, okBgP, okHlP, okMxP)
array<float> vRank  = array.from(okBinS ? math.abs(cBinS) : -1.0,
  okCbS ? math.abs(cCbS) : -1.0,
  okOkS ? math.abs(cOkS) : -1.0,
  okByS ? math.abs(cByS) : -1.0,
  okKrS ? math.abs(cKrS) : -1.0,
  okBgS ? math.abs(cBgS) : -1.0,
  okGtS ? math.abs(cGtS) : -1.0,
  okHtS ? math.abs(cHtS) : -1.0,
  okMxS ? math.abs(cMxS) : -1.0,
  okHlS ? math.abs(cHlS) : -1.0,
  okBinP ? math.abs(cBinP) : -1.0,
  okByP ? math.abs(cByP) : -1.0,
  okOkP ? math.abs(cOkP) : -1.0,
  okBgP ? math.abs(cBgP) : -1.0,
  okHlP ? math.abs(cHlP) : -1.0,
  okMxP ? math.abs(cMxP) : -1.0)
array<int> vOrder = array.sort_indices(vRank, order.descending)

// ── consensus & dominance ────────────────────────────────────────────────────
// Consensus: how many active venues agree with the global cumulative direction.
int glblSign = glblC > 0 ? 1 : glblC < 0 ? -1 : 0
int agreeCnt = 0
for i = 0 to 15
    if array.get(vAct, i)
        float cv = array.get(vCumv, i)
        int sg = cv > 0 ? 1 : cv < 0 ? -1 : 0
        if sg != 0 and sg == glblSign
            agreeCnt := agreeCnt + 1

int   actCnt     = spotActive + perpActive
float consensus  = actCnt > 0 ? 100.0 * agreeCnt / actCnt : 0.0
int   topIdx     = actCnt > 0 ? array.get(vOrder, 0) : 0
float dominance  = actCnt > 0 ? math.abs(array.get(vShare, topIdx)) : 0.0
string topVenue  = actCnt > 0 ? array.get(vName, topIdx) : "—"




// ── fallback detection ───────────────────────────────────────────────────────
//  A venue silently drops to chart-bar classification whenever its intrabar
//  request comes back empty - typically because the feed's 1m history does not
//  reach as far back as the anchor window. That mixes two different calculation
//  methods across one chart, and on a 4H chart the fallback bar is 4 hours wide,
//  which is drastically coarser than 1m. This counts it so the mixing is visible
//  instead of silent.
bool fbBinS = en_binS and useLtf and (na(lBinS_c) ? 0 : array.size(lBinS_c)) == 0 and not na(bBinS_c)
bool fbCbS = en_cbS and useLtf and (na(lCbS_c) ? 0 : array.size(lCbS_c)) == 0 and not na(bCbS_c)
bool fbOkS = en_okS and useLtf and (na(lOkS_c) ? 0 : array.size(lOkS_c)) == 0 and not na(bOkS_c)
bool fbByS = en_byS and useLtf and (na(lByS_c) ? 0 : array.size(lByS_c)) == 0 and not na(bByS_c)
bool fbKrS = en_krS and useLtf and (na(lKrS_c) ? 0 : array.size(lKrS_c)) == 0 and not na(bKrS_c)
bool fbBgS = en_bgS and useLtf and (na(lBgS_c) ? 0 : array.size(lBgS_c)) == 0 and not na(bBgS_c)
bool fbGtS = en_gtS and useLtf and (na(lGtS_c) ? 0 : array.size(lGtS_c)) == 0 and not na(bGtS_c)
bool fbHtS = en_htS and useLtf and (na(lHtS_c) ? 0 : array.size(lHtS_c)) == 0 and not na(bHtS_c)
bool fbMxS = en_mxS and useLtf and (na(lMxS_c) ? 0 : array.size(lMxS_c)) == 0 and not na(bMxS_c)
bool fbHlS = en_hlS and useLtf and (na(lHlS_c) ? 0 : array.size(lHlS_c)) == 0 and not na(bHlS_c)
bool fbBinP = en_binP and useLtf and (na(lBinP_c) ? 0 : array.size(lBinP_c)) == 0 and not na(bBinP_c)
bool fbByP = en_byP and useLtf and (na(lByP_c) ? 0 : array.size(lByP_c)) == 0 and not na(bByP_c)
bool fbOkP = en_okP and useLtf and (na(lOkP_c) ? 0 : array.size(lOkP_c)) == 0 and not na(bOkP_c)
bool fbBgP = en_bgP and useLtf and (na(lBgP_c) ? 0 : array.size(lBgP_c)) == 0 and not na(bBgP_c)
bool fbHlP = en_hlP and useLtf and (na(lHlP_c) ? 0 : array.size(lHlP_c)) == 0 and not na(bHlP_c)
bool fbMxP = en_mxP and useLtf and (na(lMxP_c) ? 0 : array.size(lMxP_c)) == 0 and not na(bMxP_c)

int fbNow = (fbBinS ? 1 : 0) +
  (fbCbS ? 1 : 0) +
  (fbOkS ? 1 : 0) +
  (fbByS ? 1 : 0) +
  (fbKrS ? 1 : 0) +
  (fbBgS ? 1 : 0) +
  (fbGtS ? 1 : 0) +
  (fbHtS ? 1 : 0) +
  (fbMxS ? 1 : 0) +
  (fbHlS ? 1 : 0) +
  (fbBinP ? 1 : 0) +
  (fbByP ? 1 : 0) +
  (fbOkP ? 1 : 0) +
  (fbBgP ? 1 : 0) +
  (fbHlP ? 1 : 0) +
  (fbMxP ? 1 : 0)

// Bars in which at least one active venue used the coarse fallback.
var int fbBars = 0
if newPeriod
    fbBars := 0
if fbNow > 0
    fbBars := fbBars + 1

// ── stable line selection ────────────────────────────────────────────────────
//  Which venues get drawn is ranked by LIFETIME absolute flow, not by the
//  current period. Period ranking would reorder constantly, so a line would
//  vanish mid-chart the moment its venue slipped a place, and a coloured slot
//  would jump between exchanges. Lifetime flow only ever grows, so the order is
//  effectively stable and every line keeps one identity and colour end to end.
//  The table handles the "who is driving right now" question instead.
f_life(float d) =>
    var float t = 0.0
    t := t + math.abs(d)
    t
float lfBinS = f_life(dBinS)
float lfCbS = f_life(dCbS)
float lfOkS = f_life(dOkS)
float lfByS = f_life(dByS)
float lfKrS = f_life(dKrS)
float lfBgS = f_life(dBgS)
float lfHlS = f_life(dHlS)
float lfMxS = f_life(dMxS)
float lfGtS = f_life(dGtS)
float lfHtS = f_life(dHtS)
float lfBinP = f_life(dBinP)
float lfByP = f_life(dByP)
float lfOkP = f_life(dOkP)
float lfBgP = f_life(dBgP)
float lfHlP = f_life(dHlP)
float lfMxP = f_life(dMxP)

// Pool = active AND its market type is ticked for plotting.
bool plBinS = okBinS and i_venSpot
bool plCbS = okCbS and i_venSpot
bool plOkS = okOkS and i_venSpot
bool plByS = okByS and i_venSpot
bool plKrS = okKrS and i_venSpot
bool plBgS = okBgS and i_venSpot
bool plHlS = okHlS and i_venSpot
bool plMxS = okMxS and i_venSpot
bool plGtS = okGtS and i_venSpot
bool plHtS = okHtS and i_venSpot
bool plBinP = okBinP and i_venPerp
bool plByP = okByP and i_venPerp
bool plOkP = okOkP and i_venPerp
bool plBgP = okBgP and i_venPerp
bool plHlP = okHlP and i_venPerp
bool plMxP = okMxP and i_venPerp

array<float> vLife = array.from(lfBinS, lfCbS, lfOkS, lfByS, lfKrS, lfBgS, lfGtS, lfHtS, lfMxS, lfHlS, lfBinP, lfByP, lfOkP, lfBgP, lfHlP, lfMxP)
array<bool>  vPool = array.from(plBinS, plCbS, plOkS, plByS, plKrS, plBgS, plGtS, plHtS, plMxS, plHlS, plBinP, plByP, plOkP, plBgP, plHlP, plMxP)

// Rank within the pool: how many pool venues have strictly more lifetime flow.
// 15x15 is trivial, and it keeps ties harmless (tied venues share a rank).
array<int> vLineRank = array.new_int(16, 999)
for i = 0 to 15
    if array.get(vPool, i)
        int higher = 0
        for j = 0 to 15
            if array.get(vPool, j) and j != i and array.get(vLife, j) > array.get(vLife, i)
                higher := higher + 1
        array.set(vLineRank, i, higher)

bool drBinS = array.get(vLineRank, 0) < i_topLines
bool drCbS = array.get(vLineRank, 1) < i_topLines
bool drOkS = array.get(vLineRank, 2) < i_topLines
bool drByS = array.get(vLineRank, 3) < i_topLines
bool drKrS = array.get(vLineRank, 4) < i_topLines
bool drBgS = array.get(vLineRank, 5) < i_topLines
bool drGtS = array.get(vLineRank, 6) < i_topLines
bool drHtS = array.get(vLineRank, 7) < i_topLines
bool drMxS = array.get(vLineRank, 8) < i_topLines
bool drHlS = array.get(vLineRank, 9) < i_topLines
bool drBinP = array.get(vLineRank, 10) < i_topLines
bool drByP = array.get(vLineRank, 11) < i_topLines
bool drOkP = array.get(vLineRank, 12) < i_topLines
bool drBgP = array.get(vLineRank, 13) < i_topLines
bool drHlP = array.get(vLineRank, 14) < i_topLines
bool drMxP = array.get(vLineRank, 15) < i_topLines

bool vSingle  = i_view == "Single stream"
bool vCompare = i_view == "Spot vs Perp"
bool vSpread  = i_view == "Spot-Perp Spread"
bool vVenShare = i_view == "Per-venue Share %"
bool vVenCvd   = i_view == "Per-venue CVD (z)"
bool vVenue    = vVenShare or vVenCvd

// =============================================================================
//  PLOTS
// =============================================================================
bool showCandles = vSingle and i_mode == "CVD Candles"
bool showLine    = vSingle and i_mode == "CVD Line"
bool showCols    = vSingle and i_mode == "Per-bar Delta"

color bodyCol = cvdC >= cvdO ? i_up : i_dn

// ── Single stream view ───────────────────────────────────────────────────────
plotcandle(showCandles and anyData ? cvdO : na,
           showCandles and anyData ? cvdH : na,
           showCandles and anyData ? cvdL : na,
           showCandles and anyData ? cvdC : na,
           title = "CVD Candles", color = bodyCol,
           wickcolor = bodyCol, bordercolor = bodyCol)

plot(showLine and anyData ? cvdC : na, "CVD Line", color = bodyCol, linewidth = 2)
plot(showCols and anyData ? selBar : na, "Per-bar Delta",
     color = selBar >= 0 ? i_up : i_dn, style = plot.style_columns)

// ── Spot vs Perp view ────────────────────────────────────────────────────────
plot(vCompare and anySpot ? cmpSpot : na, "Spot CVD", color = i_spot, linewidth = 2)
plot(vCompare and anyPerp ? cmpPerp : na, "Perp CVD", color = i_perp, linewidth = 2)

// ── Spot-Perp Spread view ────────────────────────────────────────────────────
// Positive = spot leading (accumulation); negative = perp leading (leverage).
color spreadCol = spread >= 0 ? i_spot : i_perp
plot(vSpread and anyCompare ? spread : na, "Spot-Perp Spread",
     color = spreadCol, style = plot.style_area, linewidth = 1)


// ── Per-venue views ──────────────────────────────────────────────────────────
// Only the enabled+active venues render; the contribution table is the legend.
plot(vVenShare and drBinS ? shBinS : na, "Share Binance·S", color = #f0b90b, linewidth = 2)
plot(vVenShare and drCbS ? shCbS : na, "Share Coinbase·S", color = #2962ff, linewidth = 2)
plot(vVenShare and drOkS ? shOkS : na, "Share OKX·S", color = #00e5ff, linewidth = 2)
plot(vVenShare and drByS ? shByS : na, "Share Bybit·S", color = #ff7043, linewidth = 2)
plot(vVenShare and drKrS ? shKrS : na, "Share Kraken·S", color = #7e57c2, linewidth = 2)
plot(vVenShare and drBgS ? shBgS : na, "Share Bitget·S", color = #26c6da, linewidth = 2)
plot(vVenShare and drGtS ? shGtS : na, "Share Gate·S", color = #5c6bc0, linewidth = 2)
plot(vVenShare and drHtS ? shHtS : na, "Share HTX·S", color = #a1887f, linewidth = 2)
plot(vVenShare and drMxS ? shMxS : na, "Share MEXC·S", color = #d4e157, linewidth = 2)
plot(vVenShare and drHlS ? shHlS : na, "Share Hyperliq·S", color = #26a69a, linewidth = 2)
plot(vVenShare and drBinP ? shBinP : na, "Share Binance·P", color = #ffca28, linewidth = 2)
plot(vVenShare and drByP ? shByP : na, "Share Bybit·P", color = #ff8a65, linewidth = 2)
plot(vVenShare and drOkP ? shOkP : na, "Share OKX·P", color = #4dd0e1, linewidth = 2)
plot(vVenShare and drBgP ? shBgP : na, "Share Bitget·P", color = #4db6ac, linewidth = 2)
plot(vVenShare and drHlP ? shHlP : na, "Share Hyperliq·P", color = #9ccc65, linewidth = 2)
plot(vVenShare and drMxP ? shMxP : na, "Share MEXC·P", color = #c0ca33, linewidth = 2)

plot(vVenCvd and drBinS ? zcBinS : na, "CVD z Binance·S", color = #f0b90b, linewidth = 2)
plot(vVenCvd and drCbS ? zcCbS : na, "CVD z Coinbase·S", color = #2962ff, linewidth = 2)
plot(vVenCvd and drOkS ? zcOkS : na, "CVD z OKX·S", color = #00e5ff, linewidth = 2)
plot(vVenCvd and drByS ? zcByS : na, "CVD z Bybit·S", color = #ff7043, linewidth = 2)
plot(vVenCvd and drKrS ? zcKrS : na, "CVD z Kraken·S", color = #7e57c2, linewidth = 2)
plot(vVenCvd and drBgS ? zcBgS : na, "CVD z Bitget·S", color = #26c6da, linewidth = 2)
plot(vVenCvd and drGtS ? zcGtS : na, "CVD z Gate·S", color = #5c6bc0, linewidth = 2)
plot(vVenCvd and drHtS ? zcHtS : na, "CVD z HTX·S", color = #a1887f, linewidth = 2)
plot(vVenCvd and drMxS ? zcMxS : na, "CVD z MEXC·S", color = #d4e157, linewidth = 2)
plot(vVenCvd and drHlS ? zcHlS : na, "CVD z Hyperliq·S", color = #26a69a, linewidth = 2)
plot(vVenCvd and drBinP ? zcBinP : na, "CVD z Binance·P", color = #ffca28, linewidth = 2)
plot(vVenCvd and drByP ? zcByP : na, "CVD z Bybit·P", color = #ff8a65, linewidth = 2)
plot(vVenCvd and drOkP ? zcOkP : na, "CVD z OKX·P", color = #4dd0e1, linewidth = 2)
plot(vVenCvd and drBgP ? zcBgP : na, "CVD z Bitget·P", color = #4db6ac, linewidth = 2)
plot(vVenCvd and drHlP ? zcHlP : na, "CVD z Hyperliq·P", color = #9ccc65, linewidth = 2)
plot(vVenCvd and drMxP ? zcMxP : na, "CVD z MEXC·P", color = #c0ca33, linewidth = 2)

hline(i_zero ? 0 : na, "Zero", color = color.new(color.gray, 55))

// Hidden outputs — all three streams + spread, for later phases / companions.
plot(spotC, "Out: Spot CVD",   display = display.none)
plot(perpC, "Out: Perp CVD",   display = display.none)
plot(glblC, "Out: Global CVD", display = display.none)
plot(spotBar, "Out: Spot Δ",   display = display.none)
plot(perpBar, "Out: Perp Δ",   display = display.none)
plot(spread,  "Out: Spread z", display = display.none)

// =============================================================================
//  DIAGNOSTICS
// =============================================================================
f_abbr(float v) =>
    float a = math.abs(v)
    a >= 1e9 ? str.tostring(v / 1e9, "#.##") + "B" :
      a >= 1e6 ? str.tostring(v / 1e6, "#.##") + "M" :
      a >= 1e3 ? str.tostring(v / 1e3, "#.##") + "K" :
      str.tostring(v, "#.##")

// Both dashboards share one position input - only one is ever visible.
string dashPos = i_dpos == "Top Left" ? position.top_left :
  i_dpos == "Bottom Right" ? position.bottom_right :
  i_dpos == "Bottom Left" ? position.bottom_left :
  i_dpos == "Middle Right" ? position.middle_right :
  position.top_right

// Per-venue views get the contribution table; everything else gets diagnostics.
bool showDiag = i_dash and not vVenue
bool showCtab = i_dash and vVenue

var table tbl = table.new(dashPos, 2, 13,
     bgcolor      = color.new(#0b0b0f, 15),
     border_color = color.new(color.gray, 70),
     border_width = 1, frame_width = 1,
     frame_color  = color.new(color.gray, 55))

if barstate.islast and not showDiag
    table.clear(tbl, 0, 0, 1, 12)

if showDiag and barstate.islast
    color cHdr = color.new(#16202e, 0)
    color cLbl = color.new(color.gray, 20)
    color cVal = color.white

    int totalActive  = spotActive + perpActive
    int totalEnabled = spotEnabled + perpEnabled

    string warn = ""
    color  warnCol = color.new(color.gray, 30)
    if not isCrypto
        warn := "non-crypto — aggregation off"
        warnCol := color.orange
    else if totalActive == 0
        warn := "no venues returned data"
        warnCol := i_dn
    else if totalActive < totalEnabled
        warn := str.tostring(totalEnabled - totalActive) + " enabled venue(s) unlisted here"
        warnCol := color.orange
    else if isSecSel and not forcedChart and ltfUsed == "1"
        warn := "seconds need Pro+ → 1m"
        warnCol := color.orange
    else if fbBars > 0
        warn := str.tostring(fbBars) + " bars used coarse chart-bar delta"
        warnCol := color.orange
    else if useLtf and depthBars < 500
        warn := "shallow history ~" + str.tostring(depthBars) + " bars"
        warnCol := color.orange
    else
        warn := "ok"
        warnCol := i_up

    // Rows 1-3 adapt to the active view.
    string r2lbl = vSingle ? i_stream + " CVD" : "Spot / Perp"
    string r2val = vSingle ? (anyData ? f_abbr(cvdC) : "—") :
      useZ ? str.tostring(zSpot, "#.##") + " / " + str.tostring(zPerp, "#.##") :
      f_abbr(spotC) + " / " + f_abbr(perpC)
    color r2col = vSingle ? (cvdC >= 0 ? i_up : i_dn) : cVal

    string r3lbl = vSingle ? "Bar Δ" : "Spread (z)"
    string r3val = vSingle ? (anyData ? f_abbr(selBar) : "—") :
      str.tostring(spread, "#.##") + "  " + (spread >= 0 ? "spot ▲" : "perp ▲")
    color r3col = vSingle ? (selBar >= 0 ? i_up : i_dn) : (spread >= 0 ? i_spot : i_perp)

    table.cell(tbl, 0, 0, "CVD ENGINE",  text_color = cVal, text_size = size.tiny, bgcolor = cHdr)
    table.cell(tbl, 1, 0, "P4 · venues", text_color = cLbl, text_size = size.tiny, bgcolor = cHdr)

    table.cell(tbl, 0, 1, "View", text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 1, i_view + (vSingle ? "" : " · " + i_norm), text_color = cVal, text_size = size.tiny)

    table.cell(tbl, 0, 2, r2lbl, text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 2, r2val, text_color = r2col, text_size = size.small)

    table.cell(tbl, 0, 3, r3lbl, text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 3, r3val, text_color = r3col, text_size = size.tiny)

    table.cell(tbl, 0, 4, "Spot / Perp Δ", text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 4, f_abbr(spotBar) + " / " + f_abbr(perpBar), text_color = cVal, text_size = size.tiny)

    table.cell(tbl, 0, 5, "Active venues", text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 5, "spot " + str.tostring(spotActive) + "/" + str.tostring(spotEnabled) +
               "  perp " + str.tostring(perpActive) + "/" + str.tostring(perpEnabled),
               text_color = cVal, text_size = size.tiny)

    table.cell(tbl, 0, 6, "Engine", text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 6, (useLtf ? "intrabar " + ltfUsed : "chart bar") +
               (useLtf ? " · ~" + str.tostring(depthBars) + "b" : ""),
               text_color = cVal, text_size = size.tiny)

    table.cell(tbl, 0, 7, "Anchor", text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 7, i_anchor + " · +" + str.tostring(barsSinceReset) + " bars",
               text_color = i_anchor == "None" ? color.orange : cVal, text_size = size.tiny)

    table.cell(tbl, 0, 8, "Requests", text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 8, str.tostring(reqUsed) + " / 40", text_color = cVal, text_size = size.tiny)

    table.cell(tbl, 0, 9, "Consensus", text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 9, actCnt > 0 ? str.tostring(consensus, "#") + "% of " +
               str.tostring(actCnt) + " venues" : "—",
               text_color = consensus >= 66 ? i_up : consensus >= 34 ? color.orange : i_dn,
               text_size = size.tiny)

    table.cell(tbl, 0, 10, "Dominant", text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 10, actCnt > 0 ? topVenue + " " + str.tostring(dominance, "#") + "%" : "—",
               text_color = dominance >= 60 ? color.orange : cVal, text_size = size.tiny)

    table.cell(tbl, 0, 11, "Fallback", text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 11, fbBars > 0 ? str.tostring(fbBars) + " bars on chart-bar" : "none",
               text_color = fbBars > 0 ? color.orange : i_up, text_size = size.tiny)

    table.cell(tbl, 0, 12, "Status", text_color = cLbl, text_size = size.tiny)
    table.cell(tbl, 1, 12, warn, text_color = warnCol, text_size = size.tiny)


// =============================================================================
//  CONTRIBUTION TABLE
// -----------------------------------------------------------------------------
//  Venues ranked by share of the anchor period's flow. Venue names are tinted to
//  match their plot colour so this table also serves as the chart legend.
// =============================================================================
// 1 header + up to 16 venue rows + 4 summary rows
var table ctb = table.new(dashPos, 6, 21,
     bgcolor      = color.new(#0b0b0f, 15),
     border_color = color.new(color.gray, 70),
     border_width = 1, frame_width = 1,
     frame_color  = color.new(color.gray, 55))

// Draws a proportional bar from block characters - a share column reads far
// faster as a bar than as a number.
f_bar(float pct) =>
    int filled = math.min(5, math.max(0, int(math.round(math.abs(pct) / 20.0))))
    string out = ""
    for i = 1 to 5
        out := out + (i <= filled ? "█" : "·")
    out

if barstate.islast and not showCtab
    table.clear(ctb, 0, 0, 5, 20)

if showCtab and barstate.islast
    table.clear(ctb, 0, 0, 5, 20)

    color hbg = color.new(#16202e, 0)
    color lbl = color.new(color.gray, 20)

    table.cell(ctb, 0, 0, "VENUE",  text_color = color.white, text_size = size.tiny, bgcolor = hbg)
    table.cell(ctb, 1, 0, "Δ",      text_color = lbl, text_size = size.tiny, bgcolor = hbg)
    table.cell(ctb, 2, 0, "Share",  text_color = lbl, text_size = size.tiny, bgcolor = hbg)
    table.cell(ctb, 3, 0, "Agr",    text_color = lbl, text_size = size.tiny, bgcolor = hbg)
    table.cell(ctb, 4, 0, "z",      text_color = lbl, text_size = size.tiny, bgcolor = hbg)
    table.cell(ctb, 5, 0, "Lead",   text_color = lbl, text_size = size.tiny, bgcolor = hbg)

    int nShow = i_showAll ? actCnt : math.min(i_topN, actCnt)

    if nShow > 0
        for r = 0 to nShow - 1
            int vi = array.get(vOrder, r)
            if array.get(vAct, vi)
                float shv = array.get(vShare, vi)
                float dv  = array.get(vDelta, vi)
                float cv  = array.get(vCumv, vi)
                float dzv = array.get(vDz, vi)
                float ldv = array.get(vLead, vi)
                int   sg  = cv > 0 ? 1 : cv < 0 ? -1 : 0
                bool  agr = sg != 0 and sg == glblSign

                table.cell(ctb, 0, r + 1, array.get(vName, vi),
                           text_color = array.get(vCol, vi), text_size = size.tiny)
                table.cell(ctb, 1, r + 1, f_abbr(dv),
                           text_color = dv >= 0 ? i_up : i_dn, text_size = size.tiny)
                table.cell(ctb, 2, r + 1, f_bar(shv) + " " + str.tostring(shv, "#") + "%",
                           text_color = shv >= 0 ? i_up : i_dn, text_size = size.tiny)
                table.cell(ctb, 3, r + 1, agr ? "▲" : "▼",
                           text_color = agr ? i_up : color.orange, text_size = size.tiny)
                table.cell(ctb, 4, r + 1, str.tostring(dzv, "#.#"),
                           text_color = color.white, text_size = size.tiny)
                table.cell(ctb, 5, r + 1, na(ldv) ? "—" : str.tostring(ldv, "#.##"),
                           text_color = na(ldv) ? lbl : (ldv >= 0 ? i_up : i_dn), text_size = size.tiny)

    // Summary rows. The venue table REPLACES the diagnostics table, so the
    // warnings and setup readouts have to live here too - a silent wrong number
    // is the failure mode this project has been guarding against throughout.
    int fr = nShow + 1

    string vwarn = ""
    color  vwcol = i_up
    if not isCrypto
        vwarn := "non-crypto — aggregation off"
        vwcol := color.orange
    else if actCnt == 0
        vwarn := "no venues returned data"
        vwcol := i_dn
    else if actCnt < spotEnabled + perpEnabled
        vwarn := str.tostring(spotEnabled + perpEnabled - actCnt) + " enabled venue(s) unlisted"
        vwcol := color.orange
    else if useLtf and depthBars < 500
        vwarn := "shallow history ~" + str.tostring(depthBars) + " bars"
        vwcol := color.orange
    else
        vwarn := "ok"

    table.cell(ctb, 0, fr, "Consensus", text_color = lbl, text_size = size.tiny)
    table.cell(ctb, 1, fr, str.tostring(consensus, "#") + "% of " + str.tostring(actCnt),
               text_color = consensus >= 66 ? i_up : consensus >= 34 ? color.orange : i_dn,
               text_size = size.tiny)

    table.cell(ctb, 0, fr + 1, "Dominant", text_color = lbl, text_size = size.tiny)
    table.cell(ctb, 1, fr + 1, topVenue + " " + str.tostring(dominance, "#") + "%",
               text_color = dominance >= 60 ? color.orange : color.white, text_size = size.tiny)

    table.cell(ctb, 0, fr + 2, "Setup", text_color = lbl, text_size = size.tiny)
    table.cell(ctb, 1, fr + 2, i_anchor + " · " + (useLtf ? "intrabar " + ltfUsed : "chart bar"),
               text_color = color.white, text_size = size.tiny)

    table.cell(ctb, 0, fr + 3, "Status", text_color = lbl, text_size = size.tiny)
    table.cell(ctb, 1, fr + 3, vwarn, text_color = vwcol, text_size = size.tiny)
